PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/api_monitor
# Link used inside emails
DASHBOARD_URL=http://localhost:5000

# LLM (Google Gemini). Get a free key at https://aistudio.google.com/apikey
# Leave the key empty to use fallback template messages.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Email (SMTP). Only the credentials live here (secrets).
# Recipients, schedule and alert filters are edited from the dashboard (Settings page).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown in emails (defaults to SMTP_USER)
SMTP_FROM=
# Optional: first-time default recipients, comma separated (afterwards edit in dashboard)
EMAIL_TO=
