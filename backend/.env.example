PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/api_monitor

# LLM (Google Gemini). Get a free key at https://aistudio.google.com/apikey
# Leave the key empty to use fallback template messages.
GEMINI_API_KEY=
# Model name is configurable in case Google renames/retires models
GEMINI_MODEL=gemini-flash-latest

# Thresholds
LATENCY_WARNING_MS=2000
LATENCY_CRITICAL_MS=4000

# Optional email (leave EMAIL_ENABLED=false to skip)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_TO=
